{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Práctica 05 — Widgets_App",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/Practica05/widgets_app",
      "program": "${workspaceFolder}/Practica05/widgets_app/lib/main.dart",
      "flutterMode": "debug",
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      }
    },
    {
      "name": "Práctica 04 — Tikitoki",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/Practica04/tikitoki",
      "program": "${workspaceFolder}/Practica04/tikitoki/lib/main.dart",
      "flutterMode": "debug",
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      }
    },
    {
      "name": "Tikitoki — San Valentín (fecha de prueba)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/Practica04/tikitoki",
      "program": "${workspaceFolder}/Practica04/tikitoki/lib/main.dart",
      "flutterMode": "debug",
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      },
      "toolArgs": [
        "--dart-define=TIKITOKI_DATE=2026-02-14"
      ]
    },
    {
      "name": "Tikitoki — Navidad (fecha de prueba)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/Practica04/tikitoki",
